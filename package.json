{
  "name": "palate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit.test.ts",
    "test:unit": "node --test --experimental-strip-types tests/unit.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "supabase:start": "npm exec --yes --package=supabase@2.109.1 -- supabase start",
    "supabase:reset": "npm exec --yes --package=supabase@2.109.1 -- supabase db reset",
    "supabase:test": "npm exec --yes --package=supabase@2.109.1 -- supabase test db"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.5",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
